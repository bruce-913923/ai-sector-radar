"{\n  \"schema_version\": \"1.0\",\n  \"snapshot_id\": \"2026-10-11-ABF-gap-01-03-221339\",\n  \"captured_at\": \"2026-10-11T22:13:39.000+08:00\",\n  \"as_of\": \"2026-10-11\",\n  \"source_base_commit\": \"2acfc7738b0fde3b08808727f6a5f241232df8d4\",\n  \"theme_id\": \"ABF\",\n  \"selected_task_ids\": [\n    \"ABF-gap-01\",\n    \"ABF-gap-02\",\n    \"ABF-gap-03\"\n  ],\n  \"scope\": {\n    \"company_tickers\": [\n      \"3037\",\n      \"8046\",\n      \"3189\"\n    ],\n    \"excluded_scope\": \"其他tasks、9月營收、未公告Q3、valuation、market-regime、門檻與排程\",\n    \"type\": \"three_layer_theme_lead_batch\"\n  },\n  \"counts\": {\n    \"selected\": 3,\n    \"attempted\": 3,\n    \"resolved\": 0,\n    \"invalidated\": 0,\n    \"blocked\": 0,\n    \"waiting_event_changed\": 0\n  },\n  \"status_changes\": [\n    {\n      \"task_id\": \"ABF-gap-01\",\n      \"before\": \"in_progress\",\n      \"after\": \"in_progress\",\n      \"assessment\": \"partial\",\n      \"conclusion\": \"南電有廠區平均利用率與高階需求方向，景碩有ABF整體85%與高層數缺料支持；兩者都未核高階專屬有效產能分母和同口徑需求。欣興本日既有partial保留；三家不能合成量化供需缺口。\"\n    },\n    {\n      \"task_id\": \"ABF-gap-02\",\n      \"before\": \"in_progress\",\n      \"after\": \"in_progress\",\n      \"assessment\": \"partial\",\n      \"conclusion\": \"欣興有需返還的產能資金支持；景碩官方LTA確認客戶訂貨及集團供給數量義務；南電有一般商品預收與產品合作。三家仍未把2027新增高階ABF產能對應至最低採購、取消責任及訂單覆蓋，維持partial。\"\n    },\n    {\n      \"task_id\": \"ABF-gap-03\",\n      \"before\": \"in_progress\",\n      \"after\": \"in_progress\",\n      \"assessment\": \"partial\",\n      \"conclusion\": \"欣興營業與業外均影響Q2獲利，媒體說法支持價格改善但無ABF獨立拆分；南電本業提升且業外下降，1.6T/mix有官方連結；景碩載板毛利14.6%→20.6%與ABF/BT/mix已有官方資料。仍欠ASP、數量、良率及ABF獨立毛利→經常性歸母EPS橋接。\"\n    }\n  ],\n  \"company_reviews\": {\n    \"ABF-gap-01\": {\n      \"3189\": {\n        \"task_id\": \"ABF-gap-01\",\n        \"ticker\": \"3189\",\n        \"company\": \"景碩\",\n        \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n        \"status\": \"in_progress\",\n        \"assessment\": \"partial\",\n        \"horizon\": \"2026Q4–2027Q3\",\n        \"conclusion\": \"ABF整體85%與高層數材料限制有公司轉述；10–15%潛在營收未滿足不是產能缺口。名目顆數已有標準，未核高階可售供給。\",\n        \"evidence\": [\n          {\n            \"ticker\": \"3189\",\n            \"company\": \"景碩\",\n            \"source\": \"https://mopsov.twse.com.tw/nas/STR/318920260824M002.pdf\",\n            \"as_of\": \"2026-08-25\",\n            \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n            \"pdf_pages\": [\n              23\n            ],\n            \"source_type\": \"issuer_presentation\",\n            \"verification\": \"原件相關頁面文字及視覺交叉核對\",\n            \"summary\": \"ABF月名目產能以31×31mm、6L million units換算；2026F一二廠14、五廠16、六廠10，未拆高階良率或合格供給。\"\n          },\n          {\n            \"ticker\": \"3189\",\n            \"company\": \"景碩\",\n            \"source\": \"https://ieknet.iek.org.tw/ieknews/news_open.aspx/news_more.aspx?actiontype=ieknews&indu_idno=1&nsl_id=a96b5c896c904f9a8c3ada86ded773ea\",\n            \"as_of\": \"2026-08-26\",\n            \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n            \"source_type\": \"management_comments_via_CommercialTimes_IEK\",\n            \"verification\": \"已讀完整相關報導；公司轉述與法人預測分開\",\n            \"summary\": \"公司轉述ABF整體稼動率85%、年底接近95%為預期；高階缺料致每月10–15%潛在營收未滿足，非面積或產能缺口，分母算法未列。\"\n          },\n          {\n            \"ticker\": \"3189\",\n            \"company\": \"景碩\",\n            \"source\": \"https://www.moneydj.com/KMDJ/News/NewsViewer.aspx?a=04d56c46-45bd-4871-992a-7ed9cf671263\",\n            \"as_of\": \"2026-10-05\",\n            \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n            \"source_type\": \"media_report_of_management_comments\",\n            \"verification\": \"已讀完整相關報導；公司轉述與法人預測分開\",\n            \"summary\": \"公司表示Q4 ABF無新增產能，成長靠價格、利用率與訂單；未列高階限定利用率。報導法人Q4毛利32–33%未採作公司指引。\"\n          }\n        ],\n        \"unknowns\": {\n          \"high_end_utilization_pct\": null,\n          \"denominator\": null,\n          \"qualified_capacity\": null,\n          \"yield_pct\": null,\n          \"confirmed_demand\": null,\n          \"gap_pct\": null\n        },\n        \"resolution_criteria\": \"三家公司須各自定義高階產品、觀測期與利用率分母，以合格供給／良率、訂單覆蓋或交期核偏緊；ABF整體利用率、名目標準顆數或潛在營收損失不能當高階有效面積缺口。\",\n        \"next_check_at\": \"2026-10-19\",\n        \"next_event_date\": null,\n        \"next_action\": \"2026-10-19為研究重查日；續核公司原始披露與本子範圍未知，不假設公告日。\",\n        \"history_path\": \"history/theme-research/2026-10-11-ABF-gap-01-03-221339.json\",\n        \"reported_utilization\": {\n          \"pct\": 85,\n          \"as_of\": \"2026-08-26\",\n          \"scope\": \"ABF整體；觀測期與分母未列\",\n          \"high_end_only\": false,\n          \"source\": \"https://ieknet.iek.org.tw/ieknews/news_open.aspx/news_more.aspx?actiontype=ieknews&indu_idno=1&nsl_id=a96b5c896c904f9a8c3ada86ded773ea\"\n        },\n        \"reported_unmet_potential_revenue\": {\n          \"range_pct\": [\n            10,\n            15\n          ],\n          \"unit\": \"% of potential monthly revenue\",\n          \"capacity_gap_pct\": null,\n          \"denominator_method\": null,\n          \"as_of\": \"2026-08-26\",\n          \"source\": \"https://ieknet.iek.org.tw/ieknews/news_open.aspx/news_more.aspx?actiontype=ieknews&indu_idno=1&nsl_id=a96b5c896c904f9a8c3ada86ded773ea\"\n        },\n        \"nominal_capacity\": {\n          \"period\": \"2026F\",\n          \"standard\": \"31×31mm, 6L equivalent\",\n          \"unit\": \"million units/month\",\n          \"plants\": {\n            \"5\": 16,\n            \"6\": 10,\n            \"1&2\": 14\n          },\n          \"actual_qualified_output\": null,\n          \"source\": \"https://mopsov.twse.com.tw/nas/STR/318920260824M002.pdf\"\n        },\n        \"commercial_mechanism\": [\n          {\n            \"period\": \"2026Q4\",\n            \"mechanism\": \"無新增ABF產能時，價格、利用率與材料配額決定可售供給及毛利；法人季毛利預測仍需實績驗證。\",\n            \"source\": \"https://www.moneydj.com/KMDJ/News/NewsViewer.aspx?a=04d56c46-45bd-4871-992a-7ed9cf671263\",\n            \"as_of\": \"2026-10-05\",\n            \"type\": \"management_comments_via_media\",\n            \"status\": \"Partial\"\n          },\n          {\n            \"period\": \"2027H1–Q3\",\n            \"mechanism\": \"名目新產能需裝機、特定產品認證與材料供應；集團LTA與保證金需映射至新增線供貨年度/量，才可判訂單保障，亦須反映折舊與增資稀釋。\",\n            \"source\": \"https://www.kinsus.com.tw/upload/media/ir/financial-information/financial-report/115/115Q2.pdf\",\n            \"as_of\": \"2026-07-31\",\n            \"type\": \"issuer_contract_evidence_and_mechanism\",\n            \"status\": \"Partial\"\n          }\n        ],\n        \"invalidation_conditions\": [\n          \"相同產品範圍訂單遞延、價格或交期下滑，應重估偏緊與毛利延續；不設無來源數字門檻。\",\n          \"新增線材料／認證／良率未達計畫或客戶取消／預約返還，可使名目擴產無法轉成有效出貨。\",\n          \"合併毛利／EPS改善若主要來自BT、光學、業外或股數變化，不能記為高階ABF獨立利潤。\"\n        ]\n      },\n      \"8046\": {\n        \"task_id\": \"ABF-gap-01\",\n        \"ticker\": \"8046\",\n        \"company\": \"南電\",\n        \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n        \"status\": \"in_progress\",\n        \"assessment\": \"partial\",\n        \"horizon\": \"2026Q4–2027Q3\",\n        \"conclusion\": \"三廠平均>80%不等於高階ABF利用率；1.6T量產及T-glass偏緊支持方向，PCB大陸滿載與法人昆山100%預測不移植至高階ABF。\",\n        \"evidence\": [\n          {\n            \"ticker\": \"8046\",\n            \"company\": \"南電\",\n            \"source\": \"https://www.nanyapcb.com.tw/nypcb/images/InvestorRelations/FinancialReport/NYPCBCH20260506.pdf\",\n            \"as_of\": \"2026-08-27\",\n            \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n            \"pdf_pages\": [\n              7,\n              9,\n              12\n            ],\n            \"source_type\": \"issuer_presentation\",\n            \"verification\": \"原件相關頁面文字及視覺交叉核對\",\n            \"summary\": \"高階需求、1.6T量產及產品升級有公司支持；未披露高階ABF利用率、有效產量或同口徑需求。\"\n          },\n          {\n            \"ticker\": \"8046\",\n            \"company\": \"南電\",\n            \"source\": \"https://news.cts.com.tw/cna/money/202605/202605143031289.html\",\n            \"as_of\": \"2026-05-14\",\n            \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n            \"source_type\": \"CNA_management_interview_republished\",\n            \"verification\": \"已讀完整相關報導；公司轉述與法人預測分開\",\n            \"summary\": \"管理層稱三大廠區平均稼動率超過80%；未拆高階ABF、BT、PCB與平均權重，非目前高階ABF利用率。\"\n          },\n          {\n            \"ticker\": \"8046\",\n            \"company\": \"南電\",\n            \"source\": \"https://money.udn.com/money/amp/story/5612/9731359\",\n            \"as_of\": \"2026-09-03\",\n            \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n            \"source_type\": \"media_report_of_management_comments\",\n            \"verification\": \"已讀完整相關報導；公司轉述與法人預測分開\",\n            \"summary\": \"9/2電話會議報導把逐步滿載限定為PCB大陸廠區；ABF T-glass吃緊與漲價空間為方向證據。昆山Q4可能100%為法人預測，未作高階ABF實績。\"\n          }\n        ],\n        \"unknowns\": {\n          \"high_end_utilization_pct\": null,\n          \"denominator\": null,\n          \"qualified_capacity\": null,\n          \"yield_pct\": null,\n          \"confirmed_demand\": null,\n          \"gap_pct\": null\n        },\n        \"resolution_criteria\": \"三家公司須各自定義高階產品、觀測期與利用率分母，以合格供給／良率、訂單覆蓋或交期核偏緊；ABF整體利用率、名目標準顆數或潛在營收損失不能當高階有效面積缺口。\",\n        \"next_check_at\": \"2026-10-19\",\n        \"next_event_date\": null,\n        \"next_action\": \"2026-10-19為研究重查日；續核公司原始披露與本子範圍未知，不假設公告日。\",\n        \"history_path\": \"history/theme-research/2026-10-11-ABF-gap-01-03-221339.json\",\n        \"reported_utilization\": {\n          \"lower_bound_pct\": 80,\n          \"comparator\": \">\",\n          \"as_of\": \"2026-05-14\",\n          \"scope\": \"三大廠區平均，產品／權重未拆\",\n          \"source\": \"https://news.cts.com.tw/cna/money/202605/202605143031289.html\",\n          \"high_end_only\": false\n        },\n        \"commercial_mechanism\": [\n          {\n            \"period\": \"2026Q4\",\n            \"mechanism\": \"1.6T與高階產品組合、ABF價格调整可支撑本业；T-glass／良率及收款仍制約，BT不加價與ABF可能漲价分開。\",\n            \"source\": \"https://money.udn.com/money/amp/story/5612/9731359\",\n            \"as_of\": \"2026-09-03\",\n            \"type\": \"management_comments_via_media\",\n            \"status\": \"Partial\"\n          },\n          {\n            \"period\": \"2027H1–Q3\",\n            \"mechanism\": \"客戶合作開發→認證→合格產品量產與交付，須把有效ABF供給、供貨時程及採購約束對應；現有一般預收款不能填入2027訂單。\",\n            \"source\": \"https://www.nanyapcb.com.tw/nypcb/images/InvestorRelations/FinancialReport/NYPCBCH20260506.pdf\",\n            \"as_of\": \"2026-08-27\",\n            \"type\": \"issuer_product_roadmap_and_mechanism\",\n            \"status\": \"Partial\"\n          }\n        ],\n        \"invalidation_conditions\": [\n          \"相同產品範圍訂單遞延、價格或交期下滑，應重估偏緊與毛利延續；不設無來源數字門檻。\",\n          \"新增線材料／認證／良率未達計畫或客戶取消／預約返還，可使名目擴產無法轉成有效出貨。\",\n          \"合併毛利／EPS改善若主要來自BT、光學、業外或股數變化，不能記為高階ABF獨立利潤。\"\n        ]\n      }\n    },\n    \"ABF-gap-02\": {\n      \"3037\": {\n        \"task_id\": \"ABF-gap-02\",\n        \"ticker\": \"3037\",\n        \"company\": \"欣興\",\n        \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n        \"status\": \"in_progress\",\n        \"assessment\": \"partial\",\n        \"horizon\": \"2026Q4–2027Q3\",\n        \"conclusion\": \"五年產能預約與客戶資金支持可信；返還義務及負債現金流不證明2027銷售，已檢來源未公開最低採購、取消及補償條款，也不能斷言可任意取消。\",\n        \"evidence\": [\n          {\n            \"ticker\": \"3037\",\n            \"company\": \"欣興\",\n            \"source\": \"https://doc.twse.com.tw/server-java/t57sb01?step=1&colorchg=1&seamon=&mtype=A&co_id=3037&year=115\",\n            \"as_of\": \"2026-07-30\",\n            \"checked_at\": \"2026-10-11T22:13:39.000+08:00\",\n            \"pdf_pages\": [\n              45,\n              48,\n              65,\n              74,\n              82,\n              87,\n              88\n            ],\n            \"source_type\": \"issuer_report\",\n            \"verification\": \"原件相關頁面文字及視覺交叉核對\",\n            \"summary\": \"暫收客戶款39,105.971百萬元與產能保證金